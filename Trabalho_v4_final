### Variável tracado_grupo
Agrupamento de tracado_via: muitas categorias (114)
```{r}
dados %>% count(tracado_via, sort = TRUE) %>% print(n = Inf)

# agrupando as categorias em uma coluna só (tracado_grupo)
dados <- dados %>%
  mutate(
    tracado_grupo = case_when(
      str_detect(tracado_via, "Interseção|Rotatória|Retorno") ~ "Interseção",
      str_detect(tracado_via, "Em Obras|Desvio")              ~ "Obras",
      str_detect(tracado_via, "Ponte|Viaduto|Túnel")          ~ "Ponte/Viaduto/Túnel",
      str_detect(tracado_via, "Curva")                        ~ "Curva",
      str_detect(tracado_via, "Declive")                      ~ "Declive",
      str_detect(tracado_via, "Aclive")                       ~ "Aclive",
      TRUE                                                    ~ "Reta"
    ),
    tracado_grupo = relevel(factor(tracado_grupo), ref = "Reta")  # categoria mais frequente como referência
  )

# Qual foi o critério:
# Em sinistros com mais de uma característica do traçado, atribuiu-se o grupo de maior prioridade, na ordem: interseção, obras, ponte/viaduto/túnel, curva, declive e aclive; trechos retos sem outra característica formam a referência.

# Ver quantidade e proporcao por categoria:
dados %>%
  group_by(tracado_grupo) %>%
  summarise(n = n(),
            eventos = sum(vitima_grave_fatal),
            prop = round(eventos / n, 3),
            esperado = round(n * mean(dados$vitima_grave_fatal), 1),
            .groups = "drop") %>%
  arrange(desc(n)) # quantidade esperada próxima, parece um bom candidato de fato

View(dados)
```

