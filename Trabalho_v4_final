# Análise Exploratória

## Variável Resposta
```{r}
# Proporção de 0 e 1 da var. resposta
tab_resp <- dados %>%
  count(vitima_grave_fatal) %>%
  mutate(prop = round(100 * n / sum(n), 1))
tab_resp
## 0: 77.2%, 1: 22.8%

dados %>%
  count(vitima_grave_fatal) %>%
  mutate(prop = n / sum(n),
         rotulo = paste0(format(n, big.mark = ".", decimal.mark = ","), " (",
                         format(round(100 * prop, 1), decimal.mark = ","), "%)"),
         resposta = factor(vitima_grave_fatal, levels = c(0, 1),
                           labels = c("Sem vítima grave/fatal", "Com vítima grave/fatal"))) %>%
  ggplot(aes(resposta, n, fill = resposta)) +
  geom_col(width = 0.6, show.legend = FALSE) +
  geom_text(aes(label = rotulo), vjust = -0.5, size = 4) +
  scale_fill_manual(values = c("#B0323A", "#8AA8AB")) +
  scale_y_continuous(expand = expansion(mult = c(0, 0.12)),
                     labels = scales::label_number(big.mark = ".", decimal.mark = ",")) +
  labs(x = NULL, y = "Número de sinistros") +
  theme_minimal(base_size = 13) +
  theme(panel.grid.major.x = element_blank())

```



