    ),
    by = "termo"
  ) %>%
  mutate(
    OR_original = exp(beta_original),
    OR_sem_incendio = exp(beta_sem_incendio),
    variacao_OR = 100 * (OR_sem_incendio / OR_original - 1)
  )

comp_incendio %>%
  mutate(across(where(is.numeric), ~ round(.x, 3)))

# mesmos betas e razoes de chance quando comparamos o modelo final com o modelo final sem incendios 
```
Como os resultados não apresentam mudanças de uma versao pra outra, optamos por manter incendios, porque excluir exigiria refazer a modelagem.


